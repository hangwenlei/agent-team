{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs", "delegation"],
            "timeout": 30,
            "statusMessage": "校验派发白名单…"
          },
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs", "readiness"],
            "timeout": 30,
            "statusMessage": "校验前置产物…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/gate.mjs", "stop-gate"],
            "timeout": 30,
            "statusMessage": "校验交付物…"
          }
        ]
      }
    ]
  }
}
