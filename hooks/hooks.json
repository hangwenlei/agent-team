{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "delegation"
            ],
            "timeout": 30,
            "statusMessage": "校验派发白名单…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "readiness"
            ],
            "timeout": 30,
            "statusMessage": "校验前置产物…"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "writepath"
            ],
            "timeout": 30,
            "statusMessage": "校验写路径归属…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "contract"
            ],
            "timeout": 30,
            "statusMessage": "校验契约保护…"
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "rework"
            ],
            "timeout": 30,
            "statusMessage": "校验返工预算…"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "stop-gate"
            ],
            "timeout": 30,
            "statusMessage": "校验交付物…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Agent$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "deliverable"
            ],
            "timeout": 30,
            "statusMessage": "记录交付物校验…"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "ledger"
            ],
            "timeout": 30,
            "statusMessage": "回传契约哈希与触达表…"
          }
        ]
      },
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "approval-ask"
            ],
            "timeout": 30,
            "statusMessage": "记录返工批准…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'agent-team reminder: before the first Agent dispatch or the first write under .agent-team in this turn, run the gate self-check from your role file. Earlier results do not count: this session may have been resumed in another process.'",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/boot.mjs",
              "approval-prompt"
            ],
            "timeout": 30,
            "statusMessage": "核对返工批准…"
          }
        ]
      }
    ]
  }
}
